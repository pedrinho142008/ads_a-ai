<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#28105d">
<title>Milky Mix — Blended Happiness</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.unsplash.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
  --purple:#28105d;
  --purple2:#432080;
  --violet:#7851df;
  --pink:#f45c99;
  --pink-light:#ff9bc2;
  --yellow:#ffd451;
  --white:#fff;
  --cream:#fffafd;
  --ink:#29143d;
  --muted:#82768e;
  --display:'Baloo 2',sans-serif;
  --body:'Poppins',sans-serif;
  --radius:25px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{
  margin:0;
  background:var(--cream);
  color:var(--ink);
  font-family:var(--body);
  overflow-x:hidden;
}
body.lock{overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
img{display:block;max-width:100%}
button:focus-visible,a:focus-visible{
  outline:3px solid var(--yellow);
  outline-offset:4px;
}
.wrap{width:min(1160px,calc(100% - 40px));margin-inline:auto}

/* HEADER */

header{
  height:76px;
  position:absolute;
  z-index:30;
  inset:0 0 auto;
  color:white;
}
.nav{
  height:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}
.brand{
  font:800 1.35rem var(--display);
  white-space:nowrap;
}
.brand span{color:var(--pink)}
.navlinks{
  display:flex;
  align-items:center;
  gap:27px;
  font-size:.68rem;
  font-weight:700;
  text-transform:uppercase;
}
.navlinks a{transition:color .2s}
.navlinks a:hover{color:var(--yellow)}
.navright{display:flex;align-items:center;gap:12px}
.order,.btn{
  border:0;
  border-radius:50px;
  padding:12px 21px;
  background:var(--yellow);
  color:var(--purple);
  font-size:.76rem;
  font-weight:800;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  transition:transform .25s,box-shadow .25s;
}
.order:hover,.btn:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 25px #16062d35;
}
.cart-trigger,.hamb{
  height:42px;
  width:42px;
  border-radius:50%;
  border:1px solid #ffffff40;
  background:#ffffff12;
  color:white;
  display:grid;
  place-items:center;
  position:relative;
}
.cart-trigger svg{width:20px}
.count{
  position:absolute;
  right:-4px;
  top:-4px;
  min-width:19px;
  height:19px;
  border-radius:50%;
  background:var(--pink);
  font-size:10px;
  font-weight:800;
  display:grid;
  place-items:center;
}
.hamb{display:none}

/* HERO */

.hero{
  position:relative;
  isolation:isolate;
  background:var(--purple);
  color:white;
  padding:125px 0 110px;
  min-height:680px;
}

/* Iluminação discreta, sem blobs atrás da fotografia */
.hero-bg-light{
  position:absolute;
  z-index:-1;
  width:62%;
  height:100%;
  top:0;
  right:0;
  background:radial-gradient(
    ellipse at 70% 42%,
    #6540ae 0%,
    #3a1b79 43%,
    #28105d 76%
  );
  pointer-events:none;
}
.hero-grid{
  display:grid;
  grid-template-columns:.92fr 1.08fr;
  align-items:center;
  gap:15px;
}
.eyebrow{
  font-size:.68rem;
  font-weight:800;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--yellow);
}
.hero h1{
  font:800 clamp(4.5rem,8.5vw,7.7rem)/.78 var(--display);
  letter-spacing:-.065em;
  margin:25px 0;
}
.hero h1 span{
  display:block;
  color:var(--pink);
  margin-top:19px;
}
.hero-copy h2{
  font:800 1.2rem/1.15 var(--display);
  color:#ffe78c;
  margin:0;
}
.hero-copy p{
  max-width:370px;
  color:#ded4f1;
  font-size:.84rem;
  line-height:1.85;
}
.hero-actions{
  display:flex;
  align-items:center;
  gap:18px;
  flex-wrap:wrap;
  margin-top:25px;
}
.btn.pink{background:var(--pink);color:white}
.rating{
  display:flex;
  align-items:center;
  gap:9px;
  font-size:.8rem;
}
.rating b{font-size:1.6rem;color:var(--yellow)}
.rating small{
  display:block;
  color:#d5c9e9;
  font-size:.63rem;
}

/* Produto principal: a profundidade vem da luz e da sombra */

.hero-stage{
  height:470px;
  position:relative;
  display:grid;
  place-items:center;
  perspective:1000px;
}
.hero-product{
  position:relative;
  z-index:3;
  width:min(390px,100%);
  height:455px;
  display:grid;
  place-items:center;
  transform:rotate(-3deg);
  animation:float 5s ease-in-out infinite;
}
.hero-photo{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center;
  filter:drop-shadow(0 30px 23px #10052170);
}
.badge{
  position:absolute;
  z-index:7;
  right:-1%;
  bottom:20%;
  display:flex;
  align-items:center;
  gap:10px;
  padding:13px 16px;
  background:#ffffffed;
  color:var(--ink);
  border:1px solid #ffffffb0;
  border-radius:17px;
  box-shadow:0 14px 32px #17063132;
  backdrop-filter:blur(12px);
  font-size:.63rem;
}
.badge b{
  display:block;
  font-size:.78rem;
}
.badge-icon{
  width:34px;
  height:34px;
  flex-shrink:0;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#eee6ff;
  color:var(--violet);
  font-size:1rem;
}
.badge.second{
  right:auto;
  left:0;
  bottom:5%;
  transform:rotate(-3deg);
}
.spark{
  position:absolute;
  z-index:4;
  color:white;
  font-size:1.8rem;
  animation:twinkle 2.8s infinite;
}
.s1{right:3%;top:12%}
.s2{left:4%;top:21%;color:var(--yellow)}
.s3{right:8%;bottom:8%}

/* ONDAS SVG SUAVES */

.wave{
  position:absolute;
  z-index:9;
  bottom:-1px;
  left:0;
  width:100%;
  height:105px;
  display:block;
  pointer-events:none;
}
.wave path{fill:var(--cream)}

/* PRODUTOS */

.section{padding:58px 0 78px}
.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:28px;
}
.section-head h2,.why h2{
  font:800 clamp(2.3rem,4vw,3.5rem)/.92 var(--display);
  letter-spacing:-.045em;
  margin:8px 0;
}
.section-head h2 span,.why h2 span{
  display:block;
  color:var(--pink);
}
.section-head p{
  max-width:370px;
  margin:12px 0 0;
  color:var(--muted);
  font-size:.75rem;
  line-height:1.7;
}
.slider-buttons{display:flex;gap:8px}
.round-btn{
  width:39px;
  height:39px;
  border:2px solid #e7c7da;
  border-radius:50%;
  background:transparent;
  color:#c478a0;
  font-size:1.2rem;
}
.products{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:20px;
}
.product{min-width:0;text-align:center}
.product-art{
  height:250px;
  border-radius:26px;
  position:relative;
  overflow:hidden;
  display:grid;
  place-items:center;
  box-shadow:0 13px 28px #2d16400b;
  transition:transform .35s,box-shadow .35s;
}

/* Sem manchas ou formas aleatórias atrás dos produtos */
.product-art img{
  position:relative;
  z-index:1;
  width:100%;
  height:100%;
  padding:10px;
  object-fit:contain;
  object-position:center;
  filter:drop-shadow(0 15px 11px #28103c2b);
  transition:transform .4s;
}
.strawberry{background:#f66eaa}
.chocolate{background:#99604b}
.mango{background:#ffc747}
.oreo{background:#59b6df}
.product:hover .product-art{
  transform:translateY(-6px);
  box-shadow:0 23px 35px #2d16401e;
}
.product:hover .product-art img{
  transform:translateY(-4px) scale(1.035);
}
.product h3{
  font:800 1.13rem/1.05 var(--display);
  margin:14px 0 4px;
}
.desc{
  font-size:.65rem;
  color:var(--muted);
  margin:0 0 9px;
}
.product-bottom{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:11px;
}
.price{font-size:.92rem;font-weight:800}
.add{
  width:34px;
  height:34px;
  border:0;
  border-radius:50%;
  background:var(--purple);
  color:white;
  font-size:1.25rem;
  transition:.2s;
}
.add:hover{
  background:var(--pink);
  transform:scale(1.08);
}

/* COMBO */

.combo-area{padding:0 0 82px}
.combo{
  position:relative;
  isolation:isolate;
  min-height:285px;
  border-radius:34px;
  padding:35px 6%;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  overflow:visible;
  background:linear-gradient(112deg,#f45b98,#ff8fba);
  color:white;
  box-shadow:0 24px 55px #c8427924;
}
.combo-copy{position:relative;z-index:5}
.combo h2{
  font:800 clamp(2.9rem,5vw,4.5rem)/.8 var(--display);
  margin:0 0 18px;
  letter-spacing:-.05em;
}
.combo p{
  font-size:.82rem;
  line-height:1.65;
  max-width:285px;
}
.combo .btn{background:var(--purple);color:white}
.combo-art{
  position:relative;
  height:255px;
  align-self:center;
  perspective:700px;
}
.combo-art img{
  position:absolute;
  bottom:-20px;
  width:52%;
  height:280px;
  object-fit:contain;
  object-position:center;
  filter:drop-shadow(0 22px 16px #5c1b4540);
}
.combo-art .cup-a{
  left:5%;
  z-index:2;
  transform:rotate(-8deg) translateZ(25px);
}
.combo-art .cup-b{
  right:0;
  z-index:1;
  transform:rotate(8deg) translateY(-17px) translateZ(-5px);
}
.discount{
  position:absolute;
  z-index:5;
  right:-2%;
  bottom:0;
  width:75px;
  height:75px;
  border-radius:50%;
  background:var(--yellow);
  color:var(--purple);
  display:grid;
  place-content:center;
  text-align:center;
  font-weight:800;
  font-size:1.1rem;
  line-height:1;
  box-shadow:0 10px 20px #73234b30;
}
.discount small{font-size:.56rem}

/* BENEFÍCIOS */

.why{
  position:relative;
  background:var(--purple);
  color:white;
  padding:100px 0 85px;
  overflow:hidden;
  isolation:isolate;
}
.why-wave{
  position:absolute;
  top:-1px;
  left:0;
  width:100%;
  height:95px;
  z-index:1;
  pointer-events:none;
}
.why-wave path{fill:var(--cream)}
.why-inner{position:relative;z-index:2}
.why-head{
  text-align:center;
  max-width:600px;
  margin:0 auto 35px;
}
.why-head p{
  color:#d0c4e8;
  font-size:.8rem;
  line-height:1.7;
}
.benefits{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}
.benefit{
  padding:23px 13px;
  text-align:center;
  border:1px solid #ffffff23;
  background:#ffffff0b;
  border-radius:23px;
  box-shadow:inset 0 1px #ffffff16,0 14px 35px #17052d1c;
  backdrop-filter:blur(8px);
  transition:transform .3s;
}
.benefit:hover{transform:translateY(-5px)}
.benefit-icon{
  width:55px;
  height:55px;
  margin:0 auto 12px;
  display:grid;
  place-items:center;
  background:white;
  color:var(--purple);
  border-radius:18px;
  font-size:1.4rem;
}
.benefit h3{
  font:800 1rem var(--display);
  margin:0 0 5px;
}
.benefit p{
  font-size:.66rem;
  line-height:1.5;
  color:#d7cbed;
  margin:0;
}

/* AVALIAÇÃO */

.review{padding:72px 0;background:var(--cream)}
.review-card{
  max-width:760px;
  margin:auto;
  display:flex;
  align-items:center;
  gap:24px;
  padding:26px 30px;
  background:#fff0c7;
  border-radius:28px;
  box-shadow:0 24px 60px #21103c14;
}
.review-stars{color:#eaaa00;letter-spacing:3px}
.review-card p{
  font-size:.83rem;
  line-height:1.7;
  margin:8px 0;
}
.review-card strong{font-size:.75rem}
.avatar{
  flex-shrink:0;
  width:88px;
  height:88px;
  object-fit:cover;
  border-radius:50%;
  border:5px solid white;
  box-shadow:0 10px 25px #62451b20;
}

/* FOOTER */

footer{
  position:relative;
  background:var(--purple);
  color:white;
  text-align:center;
  padding:80px 20px 30px;
  overflow:hidden;
}
.footer-wave{
  position:absolute;
  top:-1px;
  left:0;
  width:100%;
  height:60px;
}
.footer-wave path{fill:var(--cream)}
footer .brand{font-size:2rem}
footer p{color:#d1c5e7;font-size:.75rem}
.socials{
  display:flex;
  justify-content:center;
  gap:12px;
  margin:20px;
}
.socials a{
  width:38px;
  height:38px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#ffffff16;
}
footer small{font-size:.65rem;color:#a89ac6}

/* CARRINHO */

.cart-overlay{
  position:fixed;
  inset:0;
  z-index:90;
  background:#13072699;
  opacity:0;
  visibility:hidden;
  transition:.25s;
}
.cart-overlay.visible{opacity:1;visibility:visible}
.drawer{
  position:fixed;
  z-index:100;
  inset:0 0 0 auto;
  width:min(430px,100%);
  background:var(--cream);
  padding:22px;
  display:flex;
  flex-direction:column;
  transform:translateX(105%);
  transition:transform .3s;
  box-shadow:-15px 0 50px #16052c30;
}
.drawer.visible{transform:translateX(0)}
.drawer-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eadfec;
  padding-bottom:15px;
}
.drawer-head h2{
  font:800 1.7rem var(--display);
  margin:0;
}
.close{
  border:0;
  background:#eee5f5;
  color:var(--purple);
  border-radius:50%;
  width:40px;
  height:40px;
  font-size:1.3rem;
}
.cart-items{flex:1;overflow:auto;padding:15px 0}
.empty{text-align:center;color:var(--muted);padding:50px 5px}
.cart-row{
  display:grid;
  grid-template-columns:1fr auto;
  gap:10px;
  padding:13px 0;
  border-bottom:1px solid #eee3ee;
}
.cart-row strong{font-size:.85rem}
.cart-row small{
  display:block;
  color:var(--muted);
  font-size:.72rem;
  margin-top:4px;
}
.qty{display:flex;align-items:center;gap:9px}
.qty button{
  border:0;
  border-radius:50%;
  width:28px;
  height:28px;
  background:#eee5f5;
  color:var(--purple);
}
.totals{border-top:1px solid #eadfec;padding-top:15px}
.total-line{
  display:flex;
  justify-content:space-between;
  margin:8px 0;
  font-size:.85rem;
}
.total-line.final{font-weight:800;font-size:1.15rem}
.checkout{
  width:100%;
  margin-top:12px;
  background:#25a85a;
  color:white;
}
.checkout:disabled{opacity:.45;cursor:not-allowed}
.note{
  font-size:.65rem;
  color:var(--muted);
  text-align:center;
  line-height:1.5;
}

/* ENTRADA SUAVE */

.reveal{
  opacity:0;
  transform:translateY(20px);
  transition:opacity .6s,transform .6s;
}
.reveal.in{opacity:1;transform:none}

/* DESKTOP */

@media(min-width:1200px){
  .hero{min-height:710px}
  .hero-stage{height:500px}
  .hero-product{height:480px;width:420px}
}

/* TABLET */

@media(max-width:850px){
  .navlinks{gap:15px}
  .hero{min-height:620px}
  .hero h1{font-size:clamp(4rem,9vw,6rem)}
  .hero-stage{height:420px}
  .hero-product{height:400px}
  .badge{right:-3%;padding:10px}
  .products{gap:13px}
  .product-art{height:210px}
  .combo-art{height:220px}
  .combo-art img{height:245px}
}

/* ANDROID / MOBILE */

@media(max-width:640px){
  .wrap{width:calc(100% - 30px)}
  header{height:68px}
  .nav{gap:8px}
  .brand{font-size:1.08rem}

  .navlinks{
    display:none;
    position:absolute;
    top:62px;
    left:15px;
    right:15px;
    background:#351477;
    border:1px solid #ffffff20;
    border-radius:19px;
    padding:12px 18px;
    box-shadow:0 20px 50px #26104b30;
    flex-direction:column;
    align-items:stretch;
    gap:0;
  }
  .navlinks.open{display:flex}
  .navlinks a{
    padding:12px 8px;
    border-bottom:1px solid #ffffff12;
  }
  .navright{gap:7px}
  .order{padding:10px 12px;font-size:.65rem}
  .hamb{display:grid}

  .hero{
    padding:100px 0 93px;
    min-height:auto;
    overflow:hidden;
  }
  .hero-bg-light{
    width:100%;
    height:57%;
    top:38%;
    background:radial-gradient(
      ellipse at 70% 45%,
      #6441a8 0%,
      #3b1c7a 48%,
      #28105d 80%
    );
  }
  .hero-grid{grid-template-columns:1fr;gap:0}
  .hero h1{
    font-size:clamp(4.6rem,19vw,6.2rem);
    margin:21px 0;
  }
  .hero-copy p{font-size:.8rem;max-width:330px}
  .hero-stage{height:355px;margin-top:10px}
  .hero-product{
    width:min(85%,340px);
    height:350px;
  }
  .badge{
    right:0;
    bottom:14%;
    padding:9px 11px;
    border-radius:14px;
    font-size:.56rem;
  }
  .badge b{font-size:.7rem}
  .badge.second{left:0;bottom:0}
  .badge-icon{width:27px;height:27px}
  .wave{height:73px}

  .section{padding:37px 0 52px}
  .section-head{align-items:end;margin-bottom:22px}
  .section-head h2{font-size:2.4rem}
  .section-head p{font-size:.67rem}
  .slider-buttons{display:none}

  .products{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:20px 12px;
  }
  .product-art{
    height:clamp(155px,47vw,220px);
    border-radius:21px;
  }
  .product-art img{padding:8px}
  .product h3{font-size:1.06rem}
  .desc{font-size:.6rem}
  .price{font-size:.83rem}
  .add{width:32px;height:32px}

  .combo-area{padding-bottom:52px}
  .combo{
    grid-template-columns:1fr;
    border-radius:26px;
    padding:28px 22px 0;
    overflow:hidden;
  }
  .combo h2{font-size:3.2rem}
  .combo p{font-size:.76rem}
  .combo-art{height:205px;margin-top:0}
  .combo-art img{
    height:220px;
    width:48%;
    bottom:-18px;
  }
  .discount{
    width:61px;
    height:61px;
    font-size:.87rem;
    right:0;
    bottom:4px;
  }

  .why{padding:83px 0 55px}
  .why-wave{height:65px}
  .benefits{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:11px;
  }
  .benefit{padding:18px 9px;border-radius:19px}
  .benefit-icon{
    width:48px;
    height:48px;
    border-radius:16px;
  }

  .review{padding:45px 0}
  .review-card{padding:19px;gap:13px;border-radius:22px}
  .review-card p{font-size:.76rem}
  .avatar{width:62px;height:62px}
  footer{padding-top:65px}
}

@media(max-width:360px){
  .wrap{width:calc(100% - 24px)}
  .brand{font-size:.95rem}
  .order{padding:10px}
  .hero h1{font-size:4rem}
  .product-art{height:145px}
  .product h3{font-size:1rem}
  .badge{font-size:.52rem}
  .badge b{font-size:.65rem}
}

@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{
    scroll-behavior:auto!important;
    animation:none!important;
    transition:none!important;
  }
  .reveal{opacity:1;transform:none}
}



/* ===== MILKYMIX TRUE DEPTH V2 ===== */

/* Cards preservados, fotografias menores e sem cortes */
.product-art {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  border-radius: 25px;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.4),
    0 12px 22px rgba(35,13,64,.12);
}
.product-art img {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  padding: 0;
  margin: 0;
  object-fit: contain;
  object-position: center;
  border-radius: 0;
  background: transparent;
  filter:
    drop-shadow(0 9px 5px rgba(36,12,48,.16))
    drop-shadow(0 19px 10px rgba(36,12,48,.12));
  transform: translateY(2px) scale(.88);
  transition: transform .45s ease, filter .45s ease;
}
.product:hover .product-art img {
  transform: translateY(-5px) scale(.94);
  filter:
    drop-shadow(0 13px 7px rgba(36,12,48,.2))
    drop-shadow(0 25px 13px rgba(36,12,48,.17));
}
.product:hover .product-art {
  transform: translateY(-4px);
  box-shadow: 0 20px 32px rgba(35,13,64,.19);
}

/* Hero: sombra de contato e copo em primeiro plano */
.hero-stage {
  position: relative;
  isolation: isolate;
  perspective: 1200px;
}
.hero-stage::after {
  content: "";
  position: absolute;
  z-index: 0;
  width: 48%;
  height: 16px;
  bottom: 6%;
  left: 26%;
  background: rgba(10,2,27,.4);
  border-radius: 50%;
  filter: blur(17px);
}
.hero-product {
  position: relative;
  z-index: 2;
  transform-style: preserve-3d;
  animation: milkymixDepthFloat 5s ease-in-out infinite;
}
.hero-photo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  padding: 0;
  border-radius: 0;
  background: transparent;
  filter:
    drop-shadow(0 8px 5px rgba(15,3,34,.18))
    drop-shadow(0 24px 15px rgba(15,3,34,.24))
    drop-shadow(0 40px 24px rgba(15,3,34,.12));
  transform: translateZ(35px);
}
@keyframes milkymixDepthFloat {
  0%,100% { transform: translateY(0) rotateY(-4deg) rotateZ(-2deg); }
  50% { transform: translateY(-11px) rotateY(3deg) rotateZ(0deg); }
}
.badge {
  z-index: 8;
  box-shadow:
    0 4px 8px rgba(20,5,42,.08),
    0 18px 30px rgba(20,5,42,.23);
}

/* Copos do combo em planos diferentes */
.combo-art {
  position: relative;
  isolation: isolate;
  perspective: 1000px;
}
.combo-art img {
  object-fit: contain;
  object-position: center bottom;
  padding: 0;
  border-radius: 0;
  background: transparent;
  filter:
    drop-shadow(0 8px 5px rgba(43,10,39,.18))
    drop-shadow(0 23px 13px rgba(43,10,39,.2));
  transition: transform .45s ease;
}
.combo-art .cup-a {
  z-index: 3;
  transform: rotate(-8deg) translateZ(35px);
}
.combo-art .cup-b {
  z-index: 2;
  transform: rotate(8deg) translateY(-17px) translateZ(-15px);
}
.combo:hover .cup-a {
  transform: rotate(-11deg) translateY(-7px) translateZ(45px);
}
.combo:hover .cup-b {
  transform: rotate(10deg) translateY(-22px) translateZ(-5px);
}

/* Não desenhar blobs atrás das fotografias */
.hero-stage::before,
.product-art::before,
.combo-art::before {
  content: none !important;
}

