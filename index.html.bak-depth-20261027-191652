<script>
/* Configure com DDI + DDD + número, somente dígitos. */
const WHATSAPP_NUMBER = "";

const menu = {
  strawberry:{name:"Strawberry Bliss",price:16.90},
  chocolate:{name:"Chocolate Crunch",price:18.90},
  mango:{name:"Mango Magic",price:16.90},
  oreo:{name:"Oreo Explosion",price:19.90}
};

const CART_KEY="milkymix_cart_v3";
let cart={};

try {
  cart=JSON.parse(localStorage.getItem(CART_KEY)||"{}")||{};
} catch(e) {
  cart={};
}

const money=n=>n.toLocaleString("pt-BR",{
  style:"currency",
  currency:"BRL"
});

function save(){
  try {
    localStorage.setItem(CART_KEY,JSON.stringify(cart));
  } catch(e) {}
}

function add(key){
  if(!menu[key])return;
  cart[key]=(cart[key]||0)+1;
  save();
  renderCart();
}

function change(key,delta){
  if(!menu[key])return;
  cart[key]=(cart[key]||0)+delta;
  if(cart[key]<=0)delete cart[key];
  save();
  renderCart();
}

function renderCart(){
  const items=Object.entries(cart).filter(([key,qty])=>
    menu[key]&&Number.isFinite(qty)&&qty>0
  );

  const count=items.reduce((sum,[key,qty])=>sum+qty,0);
  const subtotal=items.reduce((sum,[key,qty])=>
    sum+menu[key].price*qty,0
  );

  const discount=count>=2?subtotal*.2:0;

  document.querySelector("#cartCount").textContent=count;
  document.querySelector("#subtotal").textContent=money(subtotal);
  document.querySelector("#discountValue").textContent=money(discount);
  document.querySelector("#total").textContent=money(subtotal-discount);
  document.querySelector("#checkout").disabled=count===0;

  const container=document.querySelector("#cartItems");

  if(!items.length){
    container.innerHTML=
      '<div class="empty">Seu carrinho está esperando por um milkshake 🍓</div>';
    return;
  }

  container.innerHTML=items.map(([key,qty])=>`
    <div class="cart-row">
      <div>
        <strong>${menu[key].name}</strong>
        <small>${money(menu[key].price)} cada</small>
      </div>
      <div class="qty">
        <button data-minus="${key}" aria-label="Diminuir quantidade">−</button>
        <b>${qty}</b>
        <button data-plus="${key}" aria-label="Aumentar quantidade">+</button>
      </div>
    </div>
  `).join("");
}

document.addEventListener("click",event=>{
  const addButton=event.target.closest("[data-add]");
  const plusButton=event.target.closest("[data-plus]");
  const minusButton=event.target.closest("[data-minus]");

  if(addButton)add(addButton.dataset.add);
  if(plusButton)change(plusButton.dataset.plus,1);
  if(minusButton)change(minusButton.dataset.minus,-1);
});

const drawer=document.querySelector("#drawer");
const overlay=document.querySelector("#overlay");

function openCart(){
  drawer.classList.add("visible");
  overlay.classList.add("visible");
  document.body.classList.add("lock");
}

function closeCart(){
  drawer.classList.remove("visible");
  overlay.classList.remove("visible");
  document.body.classList.remove("lock");
}

document.querySelector("#openCart").addEventListener("click",openCart);
document.querySelector("#closeCart").addEventListener("click",closeCart);
overlay.addEventListener("click",closeCart);

document.addEventListener("keydown",event=>{
  if(event.key==="Escape")closeCart();
});

document.querySelector("#checkout").addEventListener("click",()=>{
  const items=Object.entries(cart).filter(([key,qty])=>
    menu[key]&&qty>0
  );

  if(!items.length)return;

  if(!/^\d{10,15}$/.test(WHATSAPP_NUMBER)){
    alert("Configure WHATSAPP_NUMBER no código com DDI, DDD e número, somente dígitos.");
    return;
  }

  const count=items.reduce((sum,[key,qty])=>sum+qty,0);
  const subtotal=items.reduce((sum,[key,qty])=>
    sum+menu[key].price*qty,0
  );
  const discount=count>=2?subtotal*.2:0;

  const lines=items.map(([key,qty])=>
    `${qty}x ${menu[key].name} — ${money(menu[key].price*qty)}`
  );

  const message=
`Olá! Quero fazer este pedido na Milky Mix:

${lines.join("\n")}

Subtotal: ${money(subtotal)}
Desconto: ${money(discount)}
Total: ${money(subtotal-discount)}

Podem confirmar disponibilidade e entrega?`;

  const url=`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  window.open(url,"_blank");
});

const hamburger=document.querySelector("#hamb");
const nav=document.querySelector("#navlinks");

hamburger.addEventListener("click",()=>{
  const opened=nav.classList.toggle("open");
  hamburger.setAttribute("aria-expanded",String(opened));
});

nav.querySelectorAll("a").forEach(link=>{
  link.addEventListener("click",()=>{
    nav.classList.remove("open");
    hamburger.setAttribute("aria-expanded","false");
  });
});

document.querySelector("#year").textContent=new Date().getFullYear();

document.querySelector("#prev").addEventListener("click",()=>{
  document.querySelector("#products").scrollBy({
    left:-240,
    behavior:"smooth"
  });
});

document.querySelector("#next").addEventListener("click",()=>{
  document.querySelector("#products").scrollBy({
    left:240,
    behavior:"smooth"
  });
});

if("IntersectionObserver" in window){
  const observer=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("in");
        observer.unobserve(entry.target);
      }
    });
  },{threshold:.12});

  document.querySelectorAll(".reveal").forEach(element=>{
    observer.observe(element);
  });
}else{
  document.querySelectorAll(".reveal").forEach(element=>{
